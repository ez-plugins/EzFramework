<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.ez-plugins.EzFramework</groupId>
        <artifactId>ezframework</artifactId>
        <version>0.2.2</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ezframework-bungee</artifactId>
    <name>EzFramework - BungeeCord</name>
    <description>BungeeCord proxy transport implementation for the EzFramework cross-server messaging API.</description>

    <dependencies>
        <!-- Core messaging API (no Bukkit/Spigot transitive pull) -->
        <dependency>
            <groupId>com.github.ez-plugins.EzFramework</groupId>
            <artifactId>ezframework-core</artifactId>
            <version>${module.core.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- BungeeCord API — provided by the proxy server at runtime.
             Available on Maven Central as a release artifact. -->
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-api</artifactId>
            <version>1.21-R0.3</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
