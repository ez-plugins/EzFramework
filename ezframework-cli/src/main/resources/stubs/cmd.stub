{{PACKAGE_LINE}}
import com.skyblockexp.ezframework.command.EzCmd;
import com.skyblockexp.ezframework.command.Subcommand;
import org.bukkit.plugin.java.JavaPlugin;
import org.bukkit.command.CommandSender;

import java.util.List;

public class {{CLASS}} extends EzCmd {
    public {{CLASS}}(JavaPlugin plugin) {
        super(plugin, "yourcommand", List.of(new Example()));
    }

    public static class Example extends Subcommand {
        public Example() { super("example"); }
        @Override public boolean execute(CommandSender sender, String[] args) { sender.sendMessage("Hello from example subcommand"); return true; }
    }
}
